# RedFlow 环境配置（示例）

# Flask
FLASK_APP=app.main:create_app
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your_secret_key_here

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# MySQL
DATABASE_URL=mysql+pymysql://redflow:redflow123@mysql:3306/redflow?charset=utf8mb4

# TDengine（可选）
TDENGINE_HOST=tdengine
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata
TDENGINE_DATABASE=redflow_metrics

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Encryption
ENCRYPTION_KEY=your_encryption_key_here

# Rate Limits
RATE_LIMIT_PUBLISH_PER_HOUR=10
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_COLLECT_PER_5MIN=50

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Publish mode: local | semi | full
PUBLISH_MODE=local
XHS_PUBLISH_IMAGE_URL=https://creator.xiaohongshu.com/publish/publish?source=official&from=menu&target=image

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
