# RedFlow 环境配置

# Flask
FLASK_APP=app.main:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=8b4f2a6d1c9e4f7a8b3c2d1e0f9a8b7c

# JWT
JWT_SECRET_KEY=6f1c9b3e5a7d4c2b8e0f1a9b4c7d2e6f
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# MySQL
DATABASE_URL=mysql+pymysql://redflow:redflow123@mysql:3306/redflow

# TDengine
TDENGINE_HOST=localhost
TDENGINE_PORT=6030
TDENGINE_USER=root
TDENGINE_PASSWORD=taosdata
TDENGINE_DATABASE=redflow_metrics

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Encryption
ENCRYPTION_KEY=6f1c9b3e5a7d4c2b8e0f1a9b4c7d2e6f

# Rate Limits
RATE_LIMIT_PUBLISH_PER_HOUR=10
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_COLLECT_PER_5MIN=50

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# Publish mode
PUBLISH_MODE=local
XHS_PUBLISH_IMAGE_URL=https://creator.xiaohongshu.com/publish/publish?source=official&from=menu&target=image

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
